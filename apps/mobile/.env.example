# Copy to .env and fill in your Supabase project values.
# If left empty, Karia falls back to bundled demo listings (no backend needed).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: base URL of a deployed Karia web app (Next.js) whose
# /api/geocode + /api/reverse-geocode routes will be used as a Nominatim proxy.
# When empty, the app calls Nominatim directly from the device.
EXPO_PUBLIC_GEOCODE_BASE_URL=
