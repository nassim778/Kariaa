# Copy this file to .env.local and fill in your Supabase project values.
# Local development: leave empty to use bundled demo listings.
# Production (Render): these two are required — the app will not start without them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin used in password-reset emails (set on Render to your live URL).
# Example: https://kariaa.onrender.com
NEXT_PUBLIC_SITE_URL=

# Required for DELETE /api/account (Apple account-deletion). Keep secret — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
