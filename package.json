{
  "name": "karia-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "web": "npm run dev --workspace apps/web",
    "mobile": "npm --prefix apps/mobile run start",
    "db:schema": "node scripts/apply-schema.mjs"
  },
  "devDependencies": {
    "pg": "^8.22.0"
  }
}
